DATABASE_URL="postgresql://postgres:12345@localhost:5432/acrebytes_address_db?schema=public"
PORT=4000

# Optional. Powers AI-assisted duplicate detection (semantic matches text-similarity
# misses, e.g. "Rajiv Chowk Metro Area" vs "Connaught Place"). Leave blank to run
# without it - falls back to text-similarity matching only, nothing breaks.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
